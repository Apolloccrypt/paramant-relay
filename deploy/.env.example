# PARAMANT: complete environment reference
#
# 98 variables. Copy to deploy/.env and fill in what the "required" blocks ask
# for. .env is NEVER committed to git.
#
# This file is the reference: every name the relay or the admin panel reads is
# here, and tests/env-documented.test.mjs fails the build if one is missing, or
# if a name here is read by nothing. It replaces a three-line file that
# documented ADMIN_TOKEN, TOTP_SECRET and RESEND_API_KEY while the code read 57
# names. Forty of them were written down nowhere at all.
#
# The root .env.example is the friendly self-host quickstart with prose; this
# one is the exhaustive list. When they disagree, this file is right.
#
# Conventions:
#   a bare assignment          you must fill this in
#   a commented-out assignment optional; the commented value is what the code
#                              uses when the variable is unset
# Every block ends with "read in:" so you can go look at what uses it.


# ==============================================================================
# RELAY: required
# ==============================================================================

# Shared secret for the operator surface: /metrics, /v2/admin/*, /v2/reload-users
# and the admin panel's calls into a relay. No default: when unset, every one of
# those endpoints refuses instead of opening. Generate: openssl rand -hex 32
# required · default: none (endpoints stay closed)
# read in: relay/relay.js, admin/server.js
ADMIN_TOKEN=

# Shared secret between the admin panel and the relays for internal-only routes,
# chiefly /v2/health/deep. Distinct from ADMIN_TOKEN on purpose: this one is
# never handed to an operator or a browser, only to the admin container.
# required (for the deep health check and admin-to-relay calls) · default: none
# read in: relay/relay.js, admin/server.js
INTERNAL_AUTH_TOKEN=

# 32-byte hex key that encrypts per-user TOTP secrets at rest. Losing it means
# every user's MFA has to be re-enrolled, so back it up with the same care as
# the users file. Generate: openssl rand -hex 32
# required (when ENABLE_USER_TOTP=true) · default: none
# read in: relay/lib/encryption.js, relay/relay.js
PARAMANT_TOTP_MASTER_KEY=


# ==============================================================================
# RELAY: identity and behaviour
# ==============================================================================

# Which endpoint family this relay serves. docker-compose.yml sets ghost_pipe;
# the code's own fallback when the variable is absent is "full".
# optional · default: full (docker-compose.yml passes ghost_pipe)
# read in: relay/relay.js
# RELAY_MODE=ghost_pipe

# Name this relay reports as on /health, /metrics and in the relay registry.
# The compose stack gives each of the five relays its own value (main, legal,
# finance, iot, health).
# optional · default: relay
# read in: relay/relay.js
# SECTOR=relay

# TCP port the process listens on inside the container.
# optional · default: 3000 for the relay, 4200 for the admin panel
# read in: relay/relay.js, admin/server.js
# PORT=3000

# Interface to bind. Leave at the default inside a container; the port mapping,
# not the bind address, is what limits exposure.
# optional · default: 0.0.0.0
# read in: relay/relay.js
# HOST=0.0.0.0

# This relay's own public URL, used when it registers with a primary and when it
# signs its heartbeat. Unset means it does not advertise itself.
# optional · default: none (no self-registration)
# read in: relay/relay.js
# RELAY_SELF_URL=https://relay.paramant.app

# The relay this one registers with, e.g. https://health.paramant.app. Unset
# means standalone.
# optional · default: none
# read in: relay/relay.js
# RELAY_PRIMARY_URL=

# Where the relay's own long-lived identity keypair is persisted. Must survive a
# container restart, or the relay gets a new identity and its past signatures
# stop verifying against it.
# optional · default: /data/relay-identity.json
# read in: relay/relay.js
# RELAY_IDENTITY_FILE=/data/relay-identity.json

# Public origin used to build links in relay-generated mail and responses.
# optional · default: https://paramant.app
# read in: relay/relay.js
# PUBLIC_ORIGIN=https://paramant.app


# ==============================================================================
# RELAY: users, API keys and licensing
# ==============================================================================

# Path to users.json (API keys, plans, entitlements). docker-compose.yml points
# this at a named volume; the bare code default is relative to the working
# directory, which is only right for a local run.
# optional · default: ./users.json (compose sets /data/users.json)
# read in: relay/relay.js, relay/lib/entitlements.js, relay/scripts/parasign-backfill-envelope-index.js
# USERS_FILE=/data/users.json

# The whole users.json inline as a JSON string, for secret managers. When set it
# wins over USERS_FILE.
# optional · default: none (USERS_FILE is used)
# read in: relay/relay.js
# USERS_JSON=

# Where one-time API-key claim links are recorded before they are redeemed.
# optional · default: /data/trial-keys.jsonl
# read in: relay/relay.js
# TRIAL_KEYS_FILE=/data/trial-keys.jsonl

# Lifetime of a one-time API-key claim link, in seconds. The key is never mailed
# in plaintext; the link is (privacy hardening H1, #268).
# optional · default: 604800 (7 days)
# read in: relay/relay.js
# CLAIM_TTL_SECONDS=604800

# Active API keys allowed per account on Community Edition. Clamped to 3..5 by
# the code, so values outside that range are silently corrected.
# optional · default: 5
# read in: relay/relay.js
# ACCOUNT_KEY_LIMIT_COMMUNITY=5

# Licensed Edition key (plk_...), which lifts the Community key cap. An invalid
# or expired key falls back to Community Edition rather than failing to boot.
# optional · default: none (Community Edition)
# read in: relay/relay.js
# PLK_KEY=

# Older name for PLK_KEY, still honoured. PLK_KEY wins when both are set.
# optional · default: none
# read in: relay/relay.js
# PARAMANT_LICENSE=


# ==============================================================================
# RELAY: limits
# ==============================================================================

# How long a blob survives in RAM before it is dropped, in milliseconds.
# optional · default: 300000 (5 minutes)
# read in: relay/relay.js
# TTL_MS=300000

# Largest single blob accepted, in bytes.
# optional · default: 5242880 (5 MB)
# read in: relay/relay.js
# MAX_BLOB=5242880

# Audit entries kept in memory.
# optional · default: 1000
# read in: relay/relay.js
# MAX_AUDIT=1000

# Queued messages kept per IoT device.
# optional · default: 1000
# read in: relay/relay.js
# MAX_DEVICE_QUEUE=1000

# Entries the relay registry holds before it stops accepting new ones.
# optional · default: 10000
# read in: relay/relay.js
# MAX_RELAY_REGISTRY=10000

# Anonymous (unauthenticated) requests allowed per hour per client.
# optional · default: 10
# read in: relay/relay.js
# ANON_RATE_PER_HOUR=10

# Soft RAM ceiling in MB. Above it the relay starts shedding rather than being
# OOM-killed. Note the code default is 512 while docker-compose.yml passes 1024.
# optional · default: 512 (compose sets 1024)
# read in: relay/relay.js
# RAM_LIMIT_MB=1024

# RAM in MB the relay keeps free as headroom.
# optional · default: 256
# read in: relay/relay.js
# RAM_RESERVE_MB=256


# ==============================================================================
# RELAY: transparency log (CT) and signed tree heads (STH)
# ==============================================================================

# Persist the Certificate Transparency log to this path. Unset keeps the CT log
# RAM-only, which is the privacy-preserving default.
# optional · default: none (RAM-only; compose sets /data/ct-log.json)
# read in: relay/relay.js
# CT_FILE=/data/ct-log.json

# Ceiling on the persisted CT log, in bytes.
# optional · default: 104857600 (100 MB)
# read in: relay/relay.js
# CT_MAX_SIZE=104857600

# Append-only file of this relay's signed tree heads.
# optional · default: /data/sth-log.jsonl
# read in: relay/relay.js
# STH_FILE=/data/sth-log.jsonl

# Directory holding STHs gossiped in by peer relays.
# optional · default: /data/peer-sths
# read in: relay/relay.js
# PEER_STH_DIR=/data/peer-sths

# STHs retained per peer.
# optional · default: 500
# read in: relay/relay.js
# PEER_STH_MAX=500

# Distinct peers whose STHs are retained at all.
# optional · default: 256
# read in: relay/relay.js
# PEER_STH_MAX_PEERS=256

# Peer STH submissions accepted per hour.
# optional · default: 120
# read in: relay/relay.js
# STH_INGEST_RATE_PER_HOUR=120

# Where the code-transparency manifest (the hash of the served frontend) is
# written and read.
# optional · default: /data/code-manifest.json
# read in: relay/relay.js
# CODE_MANIFEST_FILE=/data/code-manifest.json

# Append-only file of countersigned DPA acceptances.
# optional · default: /etc/paramant/dpa-signatures.jsonl
# read in: relay/relay.js
# DPA_FILE=/etc/paramant/dpa-signatures.jsonl


# ==============================================================================
# RELAY: crypto and wire format
# ==============================================================================

# Which algorithms are registered at startup (ADR R006). "core" is ML-KEM-768
# plus ML-DSA-65 only; "extended" registers all 18. An invalid value throws at
# boot rather than falling back, on purpose.
# optional · default: core
# read in: relay/crypto/bootstrap.js, relay/relay.js
# CRYPTO_MODE=core

# Set to 1 to emit the self-describing v1 wire header. Any other value keeps the
# v0 framing. See docs/wire-format-v1.md.
# optional · default: 0
# read in: relay/relay.js
# PARAMANT_WIRE_VERSION=0

# Path to the TLS certificate the setup wizard reads when it shows the cert's
# fingerprint. Not the certificate nginx serves.
# optional · default: deploy/certs/cert.pem, relative to the working directory
# read in: relay/relay.js
# TLS_CERT_FILE=


# ==============================================================================
# PARASIGN: document signing
# ==============================================================================

# 32-byte hex key encrypting stored ParaSign envelopes at rest. Falls back to
# PARAMANT_TOTP_MASTER_KEY when unset, so one of the two must exist for the
# envelope store to work. Generate: openssl rand -hex 32
# optional (falls back to PARAMANT_TOTP_MASTER_KEY) · default: none
# read in: relay/relay.js
# PARASIGN_STORE_KEY=

# Origin used in ParaSign verify links and in the open-API responses.
# optional · default: https://paramant.app
# read in: relay/relay.js
# PARASIGN_PUBLIC_ORIGIN=https://paramant.app

# Largest PDF the ParaSign open API accepts, in bytes.
# optional · default: 20971520 (20 MB)
# read in: relay/lib/parasign-open-api.js
# PARASIGN_MAX_PDF_BYTES=20971520

# Set to "true" to keep accepting v1 (pre domain-separation) notary signatures
# on verify. New signatures are always v2. See #208.
# optional · default: false
# read in: relay/relay.js
# PARASIGN_ACCEPT_LEGACY_V1=false


# ==============================================================================
# PARASIGN: qualified electronic signature (prototype)
# ==============================================================================
#
# All of this is off by default. With PARASIGN_QES_PROVIDER empty, POST
# /v2/qes/sign does not exist, /v2/auth/capabilities reports an empty provider,
# the /sign page shows no extra option, and the .psign receipt is unchanged.
#
# The provider signs a SHA-256 digest of the CAdES signed attributes and returns
# a signature value. The document never leaves the relay: there is no upload
# path in the Cleverbase Signing API and none here either.

# Which qualified trust service provider signs. Empty means the whole layer is
# off. "cleverbase-sandbox" targets the Cleverbase pre-production host;
# "cleverbase" targets production and refuses to start without a registered
# client, because client registration there is a manual step with an account
# manager and there is no contract yet.
# optional · default: none (feature off)
# read in: relay/lib/qes/index.js, relay/relay.js
# PARASIGN_QES_PROVIDER=

# Cleverbase Signing API host. Defaults follow PARASIGN_QES_PROVIDER:
# https://connect.acc.cleverbase.com for the sandbox, https://connect.cleverbase.com
# for production. Set this only to point at something else.
# optional · default: derived from PARASIGN_QES_PROVIDER
# read in: relay/lib/qes/cleverbase.js, relay/lib/qes/index.js
# CLEVERBASE_BASE_URL=

# OAuth 2.0 client identifier issued by Cleverbase, a UUID. Cleverbase publishes
# a client id and secret for its development and test stubs at
# https://cleverbase.com/en/dev-docs/client-registration/ ; that pair is not
# repeated here, and it would not get you far anyway: the signing host rejects
# it with invalid_client, as docs/qes-prototype.md records. A real client id and
# secret are issued per integration and belong in .env, never in git.
# optional · default: none
# read in: relay/lib/qes/cleverbase.js, relay/lib/qes/index.js
# CLEVERBASE_CLIENT_ID=

# OAuth 2.0 client secret matching CLEVERBASE_CLIENT_ID. Never in git, not even
# a sandbox one: see the client registration page linked above for the vendor's
# published stub pair.
# optional · default: none
# read in: relay/lib/qes/cleverbase.js
# CLEVERBASE_CLIENT_SECRET=

# Redirect URI registered with the OAuth client. The signer returns here with
# the authorisation code after authorising in the provider app.
# optional · default: none
# read in: relay/lib/qes/cleverbase.js
# CLEVERBASE_REDIRECT_URI=

# RFC 3161 timestamp authority, used to lift the signature from PAdES-B-B to
# PAdES-B-T. The default is DigiCert's free public timestamp service, which
# needs no account and answers over plain HTTP as RFC 3161 specifies. It is NOT
# an EU-qualified TSA: it is a code-signing timestamp service and appears on no
# member state's eIDAS trusted list. Production needs a qualified TSA, from a
# provider with a granted TSA/QTST service. Set this to an empty string to skip
# timestamping and stay honestly at PAdES-B-B.
# optional · default: http://timestamp.digicert.com
# read in: relay/lib/qes/index.js, relay/lib/qes/tsa.js
# QES_TSA_URL=http://timestamp.digicert.com


# ==============================================================================
# BILLING: Mollie
# ==============================================================================

# Which billing stance the relay takes. Empty (the production setting) means
# one-off payments only; "subscription" opens the recurring layer. It also
# decides live-versus-test when neither key alone settles it. See #326.
# optional · default: empty (one-off billing, recurring layer off)
# read in: relay/lib/mollie.js
# BILLING_MODE=

# Live Mollie API key (live_...). Its presence alone selects live mode, so do
# not put a live key on a test deployment.
# optional · default: none (billing endpoints stay closed)
# read in: relay/lib/mollie.js
# MOLLIE_API_KEY=

# Test Mollie API key (test_...). Used when BILLING_MODE is test, or when it is
# the only key present.
# optional · default: none
# read in: relay/lib/mollie.js
# MOLLIE_TEST_API_KEY=

# How long after boot the plan-expiry planner runs its first sweep. Leave it
# unset in production: the default is a random 30 to 60 seconds, which is what
# keeps five containers from all reaching the lock in the same millisecond. It
# exists so a test can watch the warning mail a customer is promised seven days
# before his term ends without waiting that long.
# optional · default: 30000-60000 (random)
# read in: relay/relay.js
# PLAN_EXPIRY_BOOT_DELAY_MS=

# ── Invoices ──────────────────────────────────────────────────────────────────
# Who the invoice says it comes from. The relay issues one numbered document per
# paid Mollie payment (PS-2026-0001, counter in redis, records kept forever) and
# mails it as a PDF. These four values are the supplier block on that document;
# Dutch law (Wet OB art. 35a) requires the name, the address and the VAT
# identification number to be on it.

# Supplier name on the invoice.
# optional · default: Paramantis Solutions B.V.
# read in: relay/lib/invoice.js
# BILLING_SELLER_NAME=Paramantis Solutions B.V.

# Supplier address. Use \n between lines; each line is printed as its own line.
# Empty means the address block is empty on every document, which is a defect on
# a real invoice: set it before taking money.
# optional · default: empty
# read in: relay/lib/invoice.js
# BILLING_SELLER_ADDRESS=Street 1\n1234 AB City\nNetherlands

# Chamber of Commerce number. Required on outgoing commercial documents of a
# Dutch B.V. (Handelsregisterwet art. 25), not by art. 35a.
# optional · default: 42115132
# read in: relay/lib/invoice.js
# BILLING_SELLER_KVK=42115132

# VAT identification number (btw-id), e.g. NL123456789B01. THE SWITCH BETWEEN A
# RECEIPT AND AN INVOICE. Without it the relay may not call the document an
# invoice, so it issues a "Payment receipt" that states "Invoice with VAT number
# follows" and logs one warning per process. Set it and every document issued
# from then on is a full VAT invoice; documents already issued keep the form they
# were issued in. Never guess this value: a wrong VAT number on an invoice costs
# the customer his deduction.
# optional · default: none (documents go out as payment receipts)
# read in: relay/lib/invoice.js
# BILLING_SELLER_VAT=

# ── Moneybird ─────────────────────────────────────────────────────────────────
# OPTIONAL, and off by default. With both variables below set, every invoice and
# every credit note the relay issues is also pushed into Moneybird as an
# EXTERNAL SALES INVOICE: the document keeps our own number (PS-2026-0001,
# CN-2026-0001) in Moneybird's `reference` field, Moneybird draws no number of
# its own and sends nothing to the customer, and our PDF is attached to it. With
# either one missing nothing is sent and no request leaves the relay.
#
# The push is AFTERCARE. It never blocks a payment, a webhook or an invoice: a
# failed push is queued and retried by a six-hour sweep until it lands. The
# documents are in redis either way, and GET /v2/admin/billing/export gives the
# same period as CSV, JSON or a zip of PDFs with no Moneybird at all.
#
# HOW TO MAKE THE TOKEN. In Moneybird: Instellingen, then Externe koppelingen /
# API, then "Nieuw token" (moneybird.com/user/applications/new). Give it the
# sales_invoices scope, copy the value once (it is not shown again) and put it
# below. The administration id is the long number in the Moneybird URL right
# after moneybird.com/, and can also be read from
# GET https://moneybird.com/api/v2/administrations.json with the same token.
# See deploy/DEPLOY-3.1.md, "Moneybird".

# Moneybird personal API token. Treat it like a password: it can read and write
# the whole administration.
# optional · default: none (nothing is pushed)
# read in: relay/lib/moneybird.js
# MONEYBIRD_TOKEN=

# Which Moneybird administration the documents go into. Digits only; anything
# else is refused and the push stays off, because this value ends up in the API
# path of an authenticated request.
# optional · default: none (nothing is pushed)
# read in: relay/lib/moneybird.js
# MONEYBIRD_ADMINISTRATION_ID=


# ==============================================================================
# EMAIL, MFA AND WEBAUTHN
# ==============================================================================

# Resend (https://resend.com) API key. Without it the relay and the admin panel
# skip sending rather than failing the request, so account mail silently does
# not arrive.
# optional · default: none (mail is skipped)
# read in: relay/relay.js, admin/server.js, admin/lib/email-templates.js
# RESEND_API_KEY=

# Base32 TOTP secret for the operator's own admin MFA.
# Generate: python3 -c "import secrets,base64; print(base64.b32encode(secrets.token_bytes(20)).decode())"
# optional · default: empty (admin TOTP disabled)
# read in: relay/relay.js
# TOTP_SECRET=

# Set to "true" to offer TOTP to end users as well as the operator. Needs
# PARAMANT_TOTP_MASTER_KEY to be set, since user secrets are encrypted at rest.
# optional · default: false
# read in: relay/relay.js
# ENABLE_USER_TOTP=false

# WebAuthn relying-party id: the registered domain, without scheme or port.
# Changing it invalidates every existing passkey.
# optional · default: paramant.app
# read in: admin/lib/webauthn.js
# WEBAUTHN_RP_ID=paramant.app

# Human-readable relying-party name shown in the browser's passkey prompt.
# optional · default: Paramant
# read in: admin/lib/webauthn.js
# WEBAUTHN_RP_NAME=Paramant

# Exact origin (scheme, host and port) WebAuthn assertions must come from. Falls
# back to SITE_URL, then to https://paramant.app.
# optional · default: SITE_URL, else https://paramant.app
# read in: admin/lib/webauthn.js
# WEBAUTHN_ORIGIN=


# ==============================================================================
# ADMIN PANEL
# ==============================================================================

# Public base URL of the site. Used for links in admin mail and as the WebAuthn
# origin fallback.
# optional · default: https://paramant.app
# read in: admin/server.js, admin/lib/email-templates.js, admin/lib/webauthn.js
# SITE_URL=https://paramant.app

# Path prefix the admin panel is mounted under, e.g. /admin. A trailing slash is
# stripped. Empty means it serves from the root.
# optional · default: empty
# read in: admin/server.js
# BASE_PATH=/admin

# Upstream URL of the main relay, which the admin panel proxies to.
# optional · default: http://relay-main:3000
# read in: admin/server.js
# RELAY_MAIN=http://relay-main:3000

# Upstream URL of the legal-sector relay.
# optional · default: http://relay-legal:3002
# read in: admin/server.js
# RELAY_LEGAL=http://relay-legal:3002

# Upstream URL of the finance-sector relay.
# optional · default: http://relay-finance:3003
# read in: admin/server.js
# RELAY_FINANCE=http://relay-finance:3003

# Upstream URL of the IoT relay.
# optional · default: http://relay-iot:3004
# read in: admin/server.js
# RELAY_IOT=http://relay-iot:3004

# Upstream URL of the health-sector relay, which is also the registry primary.
# optional · default: http://relay-health:3005
# read in: admin/server.js
# RELAY_HEALTH=http://relay-health:3005

# Comma-separated email allowlist for the hidden /developer dashboard. Empty in
# production closes it for everyone; empty with NODE_ENV=development opens it
# locally. Never hardcoded in the code.
# optional · default: empty (closed in production)
# read in: admin/lib/developer-gate.js
# DEVELOPER_ALLOWLIST=

# Standard Node environment. Only "development" has an effect here: it opens the
# developer dashboard when DEVELOPER_ALLOWLIST is empty. Leave it unset in
# production, which is what the compose stack does.
# optional · default: unset (treated as production)
# read in: admin/lib/developer-gate.js
# NODE_ENV=

# Days of audit history the admin panel keeps before pruning. Bounded on purpose
# (privacy hardening M2, #271).
# optional · default: 400
# read in: admin/lib/audit.js
# AUDIT_RETENTION_DAYS=400

# Path to the env file the visual config editor at /admin/settings may write.
# Unset keeps that editor disabled. Point it at a file on a volume mounted into
# both the admin and the relay containers; changes apply on the next relay
# restart, which the panel does not perform for you.
# optional · default: empty (editor disabled)
# read in: admin/lib/config-store.js
# ADMIN_CONFIG_ENV_PATH=/data/relay.env


# ==============================================================================
# REDIS
# ==============================================================================

# Redis connection URL, shared by the relay (ParaSign envelope store, session
# and quota state) and the admin panel. Unset means the relay falls back to
# in-memory state, which does not survive a restart and is not shared between
# the five relay containers.
# optional, but effectively required in the compose stack · default: none
# read in: relay/relay.js, admin/lib/redis.js, relay/scripts/parasign-backfill-envelope-index.js
# REDIS_URL=redis://redis:6379

# Fallback name for REDIS_URL, honoured only by the envelope-index backfill
# script. REDIS_URL wins when both are set.
# optional · default: none
# read in: relay/scripts/parasign-backfill-envelope-index.js
# RELAY_REDIS_URL=

# How long ANY redis call in the relay or the admin panel may take before it is
# called an outage. node-redis QUEUES commands while it reconnects, so against
# an unreachable server a call neither resolves nor rejects: without a deadline
# the route waits forever. It also does not time a command out on a connection
# that is up but silent (a dropped route, a wedged proxy), where the client
# still believes it is ready. This bounds both, on every call site in both
# services, by wrapping the client rather than the call sites.
# Raise it for a slow or distant redis; a value of zero or a non-number is
# ignored and the default applies, because "wait forever" is the failure this
# setting exists to prevent. A call that exceeds it becomes a 503, never a hang
# and never a wrong-credentials answer.
# optional · default: 1000 (ms)
# read in: relay/lib/redis-deadline.js, admin/lib/redis-deadline.js
# PARAMANT_REDIS_DEADLINE_MS=1000

# The same deadline for the single-use replay key itself (the per-slot SET NX in
# relay/lib/totp.js). A timeout here is reported exactly like a store error: the
# code is refused and the route answers 503, never accepted unmarked. Zero or a
# non-number is ignored, for the same reason as above.
# optional · default: 1000 (ms)
# read in: relay/lib/totp.js
# PARAMANT_TOTP_REPLAY_TIMEOUT_MS=1000

# The BASE of the floor under every credential answer from POST /api/user/login
# and /api/user/login-with-backup. An address that exists costs the handler more
# than one that does not (a second relay call, one more redis read), and that
# difference is measurable from outside. No 401, 200 or 503 on those routes
# leaves before this many milliseconds have passed since the request arrived.
#
# The real floor is this value PLUS what the address owes for its own recorded
# failures: 250 ms per failure past ten, capped at 2000 ms, the same curve
# relay/lib/auth-throttle.js applies. That part used to be charged by the relay
# against the ACCOUNT, which only an address that exists can reach, so the delay
# itself said whether the account was real. It is charged here now, against a
# counter keyed on the hashed address that counts a miss exactly like a hit, and
# the admin tells the relay not to charge it again.
#
# So the answer arrives at 250 ms for a clean address and at 2250 ms for one
# that has collected twenty failures, and it arrives there whether or not the
# address has an account. This value only has to cover the WORK (about 10 ms
# against a healthy relay); the throttle is added on top rather than hidden
# inside it. If a real answer ever overruns the floor the admin logs
# "answer overran its floor", which means this number is too low for that
# deployment. Zero or a non-number is ignored.
#
# 428 and 429 are deliberately not held back: they are not credential answers,
# their status codes tell them apart whatever the clock says, and delaying the
# 428 only delays the login page that is waiting to start hashing.
# optional · default: 250 (ms)
# read in: admin/server.js
# PARAMANT_LOGIN_MIN_ANSWER_MS=250

# The same floor for POST /api/user/login-with-backup, and it is six times
# higher because on that route the work is argon2 rather than a redis read.
# consumeBackupCode verifies the code against EVERY stored hash until one
# matches, and a wrong code matches none, so a miss costs ten full argon2id
# verifications at 64 MiB and timeCost 3. Measured: one verification p50 49.7 ms,
# ten of them p50 494.2 ms with a max of 870.9 ms. An address with no account
# pays none of it, so with the 250 ms floor of the other route the answer was
# 472.7 ms against 251.6 ms with no overlap.
#
# 1500 is 1.7x the slowest ten-hash miss measured on the machine this was set
# on. A slower box needs more and will say so: every answer that overruns its
# floor is logged as "answer overran its floor", and at that point the number
# here is too low for that deployment. The per-address throttle is added on top,
# as on the other login route. Zero or a non-number is ignored.
# optional · default: 1500 (ms)
# read in: admin/server.js
# PARAMANT_LOGIN_BACKUP_MIN_ANSWER_MS=1500

# -- ParaSend delivery receipts -----------------------------------------------
# A download (GET /v2/outbound/:hash) hands its signed delivery receipt over by
# REFERENCE: the response carries a receipt id and a hash, and the receipt
# itself comes from GET /v2/transfers/:receipt_id/receipt. The payload is about
# 18 KB, which does not fit in a response header (Node's maxHeaderSize is 16 KB,
# and nginx' default proxy_buffer_size is 4k/8k). Receipts live in REDIS when
# REDIS_URL is set, so they survive a relay restart, and in process memory
# otherwise, where they do not.

# Put the whole receipt back in the X-Paramant-Receipt response header, inline,
# alongside the reference. DEPRECATED and removed after 2026-12-01; it exists so
# a client written against the old shape keeps working for one release. Turning
# it on REQUIRES raising proxy_buffer_size on every proxy in front of the relay,
# or a download answers 502 instead.
# optional · default: off (any value other than 1 is off)
# read in: relay/relay.js
# PARAMANT_INLINE_RECEIPT_HEADER=1

# How many receipts one account may hold at once. Unset, the cap is derived from
# the account's tier: twice its outbound_per_hour from relay/lib/tiers.js, so
# community 100, pro 1000, business 4000. Set this only to force one flat number
# for every tier; it is meant for tests, which need to drive the eviction rule
# without making thousands of downloads.
# optional · default: unset (per-tier, see above)
# read in: relay/relay.js
# PARAMANT_RECEIPT_PER_ACCOUNT_MAX=

# The per-account cap for a tier with NO outbound ceiling to double, which today
# is enterprise only.
# optional · default: 10000
# read in: relay/relay.js
# PARAMANT_RECEIPT_UNCAPPED_MAX=10000

# Backstop on the total number of receipts held in PROCESS MEMORY, for a relay
# running without redis. When it is reached the largest holder loses its oldest
# receipt, never the quietest one. At roughly 14 KB per receipt the default is
# about 56 MB. Has no effect when REDIS_URL is set.
# optional · default: 4000
# read in: relay/relay.js
# PARAMANT_RECEIPT_TOTAL_MAX=4000


# ==============================================================================
# NATS JETSTREAM: optional push transport
# ==============================================================================

# NATS server URL. Unset disables NATS entirely; there is no localhost fallback,
# deliberately. Use tls:// for anything non-local, or the metadata travels in
# the clear.
# optional · default: none (NATS off)
# read in: relay/relay.js
# NATS_URL=tls://your-nats-server:4222

# NATS username, when the server uses user and password auth.
# optional · default: none
# read in: relay/relay.js
# NATS_USER=

# NATS password, paired with NATS_USER.
# optional · default: none
# read in: relay/relay.js
# NATS_PASS=

# NATS token auth, as an alternative to user and password.
# optional · default: none
# read in: relay/relay.js
# NATS_TOKEN=


# ==============================================================================
# SELF-HOST: STATIC FRONTEND AND THE SETUP WIZARD
# ==============================================================================

# "true" makes the relay serve the frontend itself, so a self-host install needs
# no separate webserver. install.sh sets it. Production keeps it false and lets
# nginx serve the files. API paths are never intercepted either way (ADR R011).
# optional · default: false
# read in: relay/relay.js
# SERVE_FRONTEND=false

# Root directory the relay serves static files from when SERVE_FRONTEND is true.
# docker-compose.yml bind-mounts ./frontend there read-only.
# optional · default: /app/frontend
# read in: relay/relay.js
# FRONTEND_ROOT=/app/frontend

# "true" keeps the first-run setup wizard reachable even after API keys exist.
# The wizard is otherwise open only while there are none. Do not leave this on.
# optional · default: false
# read in: relay/relay.js
# SETUP_MODE=false

# Env file the setup wizard writes the values it collects into.
# optional · default: .env in the working directory
# read in: relay/relay.js
# SETUP_ENV_FILE=


# ==============================================================================
# NOT READ BY THE RELAY OR THE ADMIN PANEL
# ==============================================================================
# These are consumed by docker-compose.yml, the deploy scripts or the self-host
# installers, all of them shell or YAML rather than node. They are listed here
# because they belong in a .env, and they are named in NOT_READ_BY_NODE in
# tests/env-documented.test.mjs so the suite does not report them as dead
# documentation. The "read in:" pointer on each one is checked by that suite
# too, so it cannot quietly become wrong.

# Log verbosity, passed to the relays by docker-compose.yml. Measured on
# 2026-09-02: no relay or admin source reads it, so today it changes nothing.
# optional · default: info
# read in: docker-compose.yml (and nothing else)
# LOG_LEVEL=info

# Host port the self-host install serves HTTP on. preflight.sh checks it is
# free before install and picks an alternative if it is not; post-install.sh
# compares it against the ports actually published and rewrites .env to match.
# Nothing in docker-compose.yml reads it: this repo's compose file has no nginx
# service, because production terminates TLS with the system nginx.
# optional · default: 80
# read in: deploy/preflight.sh, deploy/post-install.sh
# HTTP_PORT=8080

# Host port the self-host install serves HTTPS on. Same two readers and the same
# rewrite behaviour as HTTP_PORT.
# optional · default: 443
# read in: deploy/preflight.sh, deploy/post-install.sh
# HTTPS_PORT=8443

# Passed to every relay container by docker-compose.yml and read by nothing.
# Left documented rather than removed because deleting it from the compose file
# is a change to the running stack, not a documentation fix.
# optional · default: empty · dead as of 2026-09-02
# read in: docker-compose.yml (and nothing else)
# ADMIN_TOTP_SECRET=

# Which git tag the self-host installers clone. All three carry their own
# fallback pin and all three must be bumped together when a release is tagged;
# tests/static-sanity.sh check 9 is what holds them to that shape. See
# docs/RELEASE.md step 9.
# optional · default: the tag pinned in each installer
# read in: install.sh, frontend/install.sh, frontend/install-pi.sh
# PARAMANT_VERSION=v3.0.0
