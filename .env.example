# PARAMANT relay — environment variables
# Copy to .env and fill in your values before running docker compose.
# Never commit .env to git.

# ── Required ─────────────────────────────────────────────────────────────────

# Random secret used to authenticate /v2/reload-users and admin endpoints.
# Generate: openssl rand -hex 32
ADMIN_TOKEN=

# Redis password and URL. docker-compose.yml starts redis with
# --requirepass ${REDIS_PASSWORD}; empty, redis refuses to start.
# Generate: openssl rand -hex 32
REDIS_PASSWORD=
RELAY_REDIS_URL=redis://:CHANGE_ME_TO_REDIS_PASSWORD@redis:6379

# Encrypts users' TOTP secrets at rest. 32 bytes, base64.
# Generate: openssl rand -base64 32
PARAMANT_TOTP_MASTER_KEY=

# Second gate on the relays' internal routes (admin plane -> relay).
# Generate: openssl rand -hex 32
INTERNAL_AUTH_TOKEN=

# Your own public address: replace relay.example.org with this relay's public
# URL (one URL for all five sectors is fine). It is the relay_id that signed
# heads and receipts name. Removed, the compose file falls back to a
# paramant.app host, so a self-host's proofs would name Paramant (SELF-19);
# deploy/preflight.sh flags both the example value and a missing line.
RELAY_SELF_URL_MAIN=https://relay.example.org
RELAY_SELF_URL_HEALTH=https://relay.example.org
RELAY_SELF_URL_FINANCE=https://relay.example.org
RELAY_SELF_URL_LEGAL=https://relay.example.org
RELAY_SELF_URL_IOT=https://relay.example.org
# Where checkout returns to and the payment webhook goes; empty: paramant.app.
# PARASIGN_PUBLIC_ORIGIN=https://relay.example.org

# ── License ───────────────────────────────────────────────────────────────────
#
# Community Edition (default, free forever): max 5 active API keys.
# Licensed Edition: unlimited API keys, issued per-operator.
#
# Key format: plk_<base64url(payload_json + ed25519_signature)>
#   payload: { max_keys, expires_at, issued_to, issued_at }
#   signature: Ed25519, verified against hardcoded public key in relay.js
#
# Keys are cryptographically signed — they cannot be forged or modified.
# An invalid or expired key falls back to Community Edition gracefully.
#
# Get a license: https://paramant.app/pricing
# Verify a key:  node scripts/verify-license.js <your-plk-key>
PLK_KEY=

# ── Relay behaviour ───────────────────────────────────────────────────────────

# Relay mode controls which endpoints are enabled.
# Options: ghost_pipe | iot
# Default: ghost_pipe  (end-to-end encrypted messaging, ML-KEM-768)
RELAY_MODE=ghost_pipe

# Memory limits per relay process (MB).
RAM_RESERVE_MB=256
RAM_LIMIT_MB=1024

# ── Users / API keys ─────────────────────────────────────────────────────────

# Path to users.json inside the container (mapped to a named volume).
# You can pre-populate this file or use the admin CLI to add keys.
# USERS_FILE=/data/users.json   ← set automatically by docker-compose.yml

# Alternatively, provide the full users.json inline as a JSON string.
# Useful for secret managers (Vault, AWS Secrets Manager, Fly secrets).
# If set, USERS_FILE is ignored.
# USERS_JSON={"api_keys":[{"key":"pgp_xxx","plan":"pro","label":"alice","active":true}]}

# ── Email ────────────────────────────────────────────────────────────────

# WHO CARRIES THE MAIL: mailjet | scaleway | resend | dryrun
# Empty means mailjet. A MISSPELLED value falls back to dryrun and delivers
# NOTHING; the relay logs mail_misconfigured at boot, so read that line after
# changing anything here.
MAIL_PROVIDER=mailjet

# A SECOND carrier, on a DIFFERENT company, tried only when the first refuses.
# The outage that really happens is an account suspension, not a network blip:
# both large providers suspend new senders on their own compliance signals,
# without warning, and the way back is a support queue measured in days. This
# mail carries pickup codes and signing links, so leaving it on one provider is
# leaving the product on one provider. Set it once the second account exists.
MAIL_FALLBACK_PROVIDER=resend

# The envelope address. The customer's name is put in front of it per message
# ("Anna de Vries via Paramant <noreply@paramant.app>"), so SPF and DKIM keep
# passing while the reader still sees who sent it.
# Quoted: unquoted, the space and the <> break `set -a; . ./.env` on the host.
# docker compose strips the quotes. Do not export the whole file through
# `xargs`; docs/self-hosting.md reads only ADMIN_TOKEN out of it.
MAIL_FROM="PARAMANT <noreply@paramant.app>"

# Lettermint (https://lettermint.co) -- Lettermint B.V., Zwolle, the
# Netherlands. Mail data stays in the EU. Filling in the token IS the switch
# when MAIL_PROVIDER is empty: lettermint heads the preference list. Add
# Lettermint's SPF include and DKIM records first. Steps: RUNBOOK.md, Partners.
LETTERMINT_API_TOKEN=
# Optional route slug inside the Lettermint project; empty = default route.
LETTERMINT_ROUTE=

# Mailjet (https://app.mailjet.com/account/apikeys) -- Mailjet SAS, Paris,
# owned by Sinch AB (Sweden). Data stays in the EU, which is what this product
# sells. 6,000 mails a month on the free tier, no card needed to start.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Scaleway Transactional Email -- cheaper at volume (EUR 0.25 per 1,000) and
# wired up, but their billing refused the card on file. Left here so the switch
# is one setting if that ever clears.
SCALEWAY_SECRET_KEY=
SCALEWAY_PROJECT_ID=
SCALEWAY_REGION=fr-par

# Resend -- a US company, which is why we left. Kept as a way back only.
RESEND_API_KEY=

# ── Sending to named recipients ──────────────────────────────────────────

# Pseudonymises recipient addresses in the send store.
# Generate ONCE:  openssl rand -hex 32
# NEVER change it afterwards: a fresh value per restart means the hashes stop
# matching the ones already written.
RECIPIENT_HASH_KEY=

# ── TOTP / MFA (optional) ─────────────────────────────────────────────────

# Base32 secret for admin TOTP (Google Authenticator compatible).
# Generate: python3 -c "import secrets,base64; print(base64.b32encode(secrets.token_bytes(20)).decode())"
TOTP_SECRET=

# ── Billing / Stripe (optional — only needed for SaaS deployments) ────────

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_KANTOOR=
STRIPE_DEVICE_PRICE_ID=

# ── Logging (optional) ───────────────────────────────────────────────────────
# Log verbosity: debug | info | warn | error  (default: info)
# LOG_LEVEL=info

# ── Port overrides (optional) ─────────────────────────────────────────────────
# Change if ports 80/443 are already in use (e.g. Caddy, Apache, nginx)
# HTTP_PORT=8080
# HTTPS_PORT=8443

# ── CT log persistence (optional) ────────────────────────────────────────────
# The Certificate Transparency log is persisted by default, beside the signed
# tree heads: the directory of STH_FILE, or /data/ct-log.json. Set CT_FILE to
# put it somewhere else. Use an absolute path, writable by the relay process.
# Set it to an EMPTY value for RAM-only, and know what that costs: the relay
# identity and the signed head history survive a restart, so a relay that comes
# back with an empty tree would sign a second history under the same key. It
# refuses to, and stops issuing heads instead.
# CT_FILE=/data/ct-log.json

# ── NATS JetStream (optional — push transport) ────────────────────────────────
# When unset, NATS is disabled entirely. Set NATS_URL to enable.
# Use tls:// for non-localhost connections to prevent metadata exposure.
# NATS_URL=tls://your-nats-server:4222
# NATS_USER=paramant
# NATS_PASS=
# NATS_TOKEN=

# -- Crypto mode (optional) -----------------------------------------------------
# Which algorithms to register at startup (see ADR R006).
#   core     (default) = ML-KEM-768 + ML-DSA-65 only (FIPS 203/204).
#   extended           = all 18 algorithms (ML-KEM-512/1024, ML-DSA-44/87,
#                        Falcon-512/1024, all SLH-DSA variants).
# Use 'extended' only if you have power-users assembling raw HTTP PQHB blobs
# with non-default algorithm IDs. The official SDKs (sdk-js, sdk-py) and the
# browser crypto always use ML-KEM-768 + ML-DSA-65, so 'core' suffices for them.
# CRYPTO_MODE=core

# -- Admin visual config editor (optional) --------------------------------------
# Set this on the ADMIN service to enable the /admin/settings page, which lets
# operators edit whitelisted config keys from the UI instead of hand-editing
# this file over SSH. Point it at the env file the relays load -- normally a
# file on a volume mounted into both the admin and relay containers.
# Whitelist-driven (admin/lib/config-schema.js); secrets are masked + replace-
# only. If unset, the editor stays disabled. Changes apply on the next relay
# restart (the panel does not restart relays automatically).
# ADMIN_CONFIG_ENV_PATH=/data/relay.env

# -- Static frontend serving (opt-in for plug-and-play self-host) --------------
# false (default): production mode -- nginx serves frontend/, relay serves API only.
# true: the relay serves /setup, /dashboard, /send, etc directly for non-API GET
#       requests, so a self-host install needs no external webserver. install.sh
#       sets this to true. API paths (/v2/*, /api/*, /ct/*, /health, /metrics) are
#       never intercepted. Files come from FRONTEND_ROOT, mounted read-only by
#       docker-compose.yml (./frontend -> /app/frontend:ro). See ADR R011.
SERVE_FRONTEND=false
FRONTEND_ROOT=/app/frontend
